# ============================================================
# kikin-cliente — exemplo de .env para HOMOLOGAÇÃO
# Copie para .env e preencha. O deploy usa docker-compose.hml.yml.
# Gere segredos com: openssl rand -hex 32
# ============================================================

# ---- Banco (novo container kikin-cliente-db) ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-me
POSTGRES_DB=kikin_cliente
KIKIN_CLIENTE_VOLUME_PATH=/home/kikin-cliente

# ---- Identidade/API do gateway ----
JWT_SECRET=troque-me-32-chars-min
PORT=3100

# URL pública do portal (usada em redirects OAuth e CORS)
CLIENT_APP_URL=https://hml-cliente.kikin.com.br
OAUTH_REDIRECT_URI=https://hml-cliente.kikin.com.br/auth
CORS_ORIGINS=https://hml-cliente.kikin.com.br

# ---- Comunicação com o Kikin (ADR-002) ----
# A chave PRECISA ser a MESMA configurada no backend do Kikin
# (env KIKIN_CLIENT_PORTAL_SECRET no /home/kikin/app/.env), com o serviço 'client-portal'.
KIKIN_CLIENT_PORTAL_ID=client-portal
KIKIN_CLIENT_PORTAL_SECRET=troque-me
# (KIKIN_API_URL/KIKIN_PUBLIC_URL apontam p/ kikin-backend na rede docker — definidos no compose)

# ---- OAuth Google/Microsoft (mesmos client IDs do Kikin) ----
# ATENÇÃO: adicione https://hml-cliente.kikin.com.br/auth como redirect autorizado
# nos consoles Google Cloud e Microsoft Entra.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ---- E-mail (opcional; sem SMTP o token de verificação volta na resposta em HML) ----
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Kikin Cliente <nao-responda@kikin.com>

# ---- WhatsApp (OTP/lembretes) ----
WHATSAPP_PROVIDER=openwa
WHATSAPP_OPENWA_URL=https://wa.kikin.com.br
WHATSAPP_OPENWA_API_KEY=
WHATSAPP_OPENWA_SESSION=
# Chave AES-256-GCM p/ criptografar números em repouso (min 16 chars)
WHATSAPP_PHONE_KEY=troque-me-com-16+chars
