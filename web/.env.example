# kikin-cliente/web — variáveis de ambiente (copie para .env)
# URL base do gateway (porta 3100 em dev)
VITE_API_URL=http://localhost:3100/api/v1

# Client IDs OAuth (dev local / hml / prod). Devem ser os mesmos usados no server
# (GOOGLE_CLIENT_ID / MICROSOFT_CLIENT_ID) e ter como redirect autorizado
# a URL do frontend + '/auth' (ex.: http://localhost:5174/auth).
# Enquanto não houver client ID configurado, os botões sociais ficam desabilitados
# e o login/cadastro segue funcionando com e-mail + senha.
VITE_GOOGLE_CLIENT_ID=
VITE_MICROSOFT_CLIENT_ID=
