# kikin-cliente/server — variáveis de ambiente (copie para .env)
# Banco Postgres do portal (contas do cliente final)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kikin_cliente

# Sessões JWT (access 2h) — mínimo 32 caracteres
JWT_SECRET=troque-por-um-segredo-longo-32-caracteres!
JWT_EXPIRES_IN=2h

# URL pública do frontend do portal (CORS + base do redirect OAuth)
CLIENT_APP_URL=http://localhost:5174
# Opcional: origens CORS adicionais separadas por vírgula (default = CLIENT_APP_URL)
# CORS_ORIGINS=

# API interna do Kikin (ADR-002 — HMAC X-Service-*)
KIKIN_API_URL=http://localhost:3000/internal/client-portal
KIKIN_CLIENT_PORTAL_ID=client-portal
KIKIN_CLIENT_PORTAL_SECRET=troque-por-um-segredo

# SMTP opcional para e-mails de verificação/reset.
# Sem SMTP configurado e fora de produção, o token volta na resposta da API
# (EMAIL_VERIFY_RETURN_TOKEN=true) — conveniente em dev/hml.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
EMAIL_VERIFY_RETURN_TOKEN=true

# OAuth social (Google/Microsoft). Código trocado server-side (padrão do Kikin).
# Os client IDs devem ter authorized redirect URI = CLIENT_APP_URL + '/auth'.
# Ex.: http://localhost:5174/auth (dev) e https://cliente.kikin.com.br/auth (prod).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Opcional: força a URI de retorno OAuth (default CLIENT_APP_URL + '/auth')
# OAUTH_REDIRECT_URI=
